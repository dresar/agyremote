# Salin ke .env dan isi nilai riil. JANGAN commit .env ke git.
PORT=8788
HOST=0.0.0.0
ADMIN_AUTH_KEY=<bearer-token-admin>
ADMIN_AUTH_KEYS=<koma-dipisah: login-password,token-legacy,...>
BYNARA_KEYS=<sk-...,sk-...>
PROFILES_ROOT=/opt/data/home/agy-profiles
AGY_BIN_PATH=/opt/data/home/.local/bin/agy
WORKSPACE_ROOT=/opt/data
